{
  "name": "jigsaw-agent",
  "version": "1.2.0",
  "description": "Jigsaw Agent Desktop - Multi-turn AI chat with autonomous tools",
  "main": "electron/main.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "electron-dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "fetch-docs": "node scripts/fetch-docs.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HKHOP/jigsaw-agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "playwright": "^1.61.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jigsaw-agent.desktop",
    "productName": "Jigsaw Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!data/**",
      "!dist/**",
      "!build/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "HKHOP",
      "repo": "jigsaw-agent"
    },
    "releaseInfo": {
      "releaseNotes": "See the release on GitHub for details."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Jigsaw Agent"
    }
  }
}
